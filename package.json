{
  "name": "toolspage",
  "version": "1.0.0",
  "private": true,
  "description": "Toolspage production-ready web utilities",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:clean": "node scripts/start-clean.js",
    "restart:clean": "node scripts/start-clean.js",
    "start:api": "node server/index.js",
    "start:worker": "node server/worker.js",
    "dev": "nodemon server/index.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "ci": "npm test && npm run smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "bullmq": "^5.56.1",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
