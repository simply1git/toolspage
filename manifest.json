{
  "name": "Toolspage Precision Utilities",
  "short_name": "Toolspage",
  "description": "Elite-grade file and media processing utility hub.",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#030712",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "./toolspage_pwa_logo_512_1774686270114.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./toolspage_pwa_logo_512_1774686270114.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "categories": ["utilities", "productivity", "media"],
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "shared_file",
          "accept": ["video/*", "image/*", "application/pdf"]
        }
      ]
    }
  }
}
