PORT=8080
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false

# CORS origins, comma-separated. Leave empty to allow all origins.
CORS_ORIGINS=

# Upload and rate controls
FILE_UPLOAD_LIMIT_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
DISTRIBUTED_RATE_LIMIT=false

# Optional API key protection for processing routes
API_KEY=
# HMAC secret for signed output URLs (recommended in production)
OUTPUT_SIGNING_SECRET=
# Enforce secure startup checks when NODE_ENV=production
STRICT_PRODUCTION_CONFIG=true

# Async processing controls for large files
ASYNC_THRESHOLD_MB=8
JOB_TTL_MS=1800000
JOB_CLEANUP_MS=60000
JOB_CONCURRENCY=2
PDF_JOB_CONCURRENCY=2
MEDIA_JOB_CONCURRENCY=2
PDF_QUEUE_MAX_PENDING=0
MEDIA_QUEUE_MAX_PENDING=0

# Optional persistent queue backend (BullMQ + Redis)
REDIS_URL=
QUEUE_NAME=toolspage-jobs
PDF_QUEUE_NAME=toolspage-jobs-pdf
MEDIA_QUEUE_NAME=toolspage-jobs-media
REDIS_CONNECT_TIMEOUT_MS=3000
RUN_QUEUE_WORKER_IN_API=true
# In production this should normally remain false (fail fast if Redis is down)
ALLOW_IN_MEMORY_QUEUE_FALLBACK=true

# Output storage for async jobs: local | s3
STORAGE_PROVIDER=local
OUTPUT_LOCAL_DIR=./data/outputs
OUTPUT_PUBLIC_BASE_URL=
SIGNED_URL_TTL_SEC=900
OUTPUT_RETENTION_SEC=86400
OUTPUT_AUDIT_LOG_PATH=./data/output-audit.log

# S3/MinIO settings when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OCR provider for scanned PDFs: none | ocrspace
OCR_PROVIDER=none
OCR_SPACE_API_KEY=

# Compression engine: auto | pdf-lib | ghostscript
COMPRESS_ENGINE=auto
GHOSTSCRIPT_COMMAND=gs

# Optional malware scan hook
ENABLE_CLAM_SCAN=false
CLAMSCAN_COMMAND=clamscan

# Media processing runtime
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe
FFMPEG_REQUIRED=true
FFMPEG_TIMEOUT_MS=180000
FFPROBE_TIMEOUT_MS=20000
MEDIA_UPLOAD_LIMIT_MB=25
# Max size for URL-downloaded output files (separate from upload cap)
MEDIA_URL_OUTPUT_LIMIT_MB=0
MEDIA_MAX_DURATION_SEC=1800
MEDIA_REQUIRE_RIGHTS_CONFIRMATION=false
MEDIA_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.m4v
MEDIA_AUDIO_EXTENSIONS=.mp3,.wav,.aac,.ogg,.m4a,.flac
MEDIA_AUDIO_OUTPUT_FORMATS=mp3,wav,aac,ogg,m4a

# YouTube and platform video downloading (yt-dlp)
YTDLP_BINARY=yt-dlp
YTDLP_TIMEOUT_MS=300000
YTDLP_DEFAULT_QUALITY=4k60
YTDLP_PLAYLIST_MAX_ITEMS=25
# Keep disabled unless you explicitly need insecure downloader transport
YTDLP_ALLOW_INSECURE_TRANSPORT=false

# URL ingestion enabled for YouTube, Vimeo, and other platforms
MEDIA_URL_INGEST_ENABLED=true
# Leave empty to allow all platforms (single-user mode)
# Or set specific domains: youtube.com,vimeo.com,dailymotion.com
MEDIA_URL_ALLOWLIST=
