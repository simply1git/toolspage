# Toolspage production baseline
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=true

# Security
API_KEY=replace-with-strong-random-value
OUTPUT_SIGNING_SECRET=replace-with-separate-long-random-secret
STRICT_PRODUCTION_CONFIG=true
CORS_ORIGINS=https://app.example.com,https://www.example.com

# Rate limiting
DISTRIBUTED_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Upload and processing limits
FILE_UPLOAD_LIMIT_MB=25
ASYNC_THRESHOLD_MB=8
JOB_CONCURRENCY=2
PDF_JOB_CONCURRENCY=2
MEDIA_JOB_CONCURRENCY=2
PDF_QUEUE_MAX_PENDING=0
MEDIA_QUEUE_MAX_PENDING=0
JOB_TTL_MS=1800000
JOB_CLEANUP_MS=60000

# Queue backend
REDIS_URL=redis://redis:6379
QUEUE_NAME=toolspage-jobs
PDF_QUEUE_NAME=toolspage-jobs-pdf
MEDIA_QUEUE_NAME=toolspage-jobs-media
REDIS_CONNECT_TIMEOUT_MS=3000
RUN_QUEUE_WORKER_IN_API=false
ALLOW_IN_MEMORY_QUEUE_FALLBACK=false

# Output storage
STORAGE_PROVIDER=s3
SIGNED_URL_TTL_SEC=900
OUTPUT_RETENTION_SEC=86400
OUTPUT_AUDIT_LOG_PATH=/data/output-audit.log

# S3 / MinIO
S3_BUCKET=toolspage-outputs
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OCR
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=

# Compression engine
COMPRESS_ENGINE=auto
GHOSTSCRIPT_COMMAND=gs

# Security scan hook
ENABLE_CLAM_SCAN=false
CLAMSCAN_COMMAND=clamscan

# Media processing runtime
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe
FFMPEG_REQUIRED=true
FFMPEG_TIMEOUT_MS=180000
FFPROBE_TIMEOUT_MS=20000
MEDIA_UPLOAD_LIMIT_MB=50
MEDIA_URL_OUTPUT_LIMIT_MB=0
MEDIA_MAX_DURATION_SEC=1800
MEDIA_REQUIRE_RIGHTS_CONFIRMATION=false
MEDIA_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.m4v
MEDIA_AUDIO_EXTENSIONS=.mp3,.wav,.aac,.ogg,.m4a,.flac
MEDIA_AUDIO_OUTPUT_FORMATS=mp3,wav,aac,ogg,m4a

# YouTube/Platform Video Download (yt-dlp)
# Binary location (auto-downloaded if not found)
YTDLP_BINARY=yt-dlp
# Timeout for download operations (5 minutes default)
YTDLP_TIMEOUT_MS=300000
# Quality: low, medium, high
YTDLP_DEFAULT_QUALITY=4k60
# Max items processed for playlist/channel downloads
YTDLP_PLAYLIST_MAX_ITEMS=25
YTDLP_ALLOW_INSECURE_TRANSPORT=false

# URL ingestion control
# For personal use: set to true
# For public deployment: keep false unless you have proper legal review
MEDIA_URL_INGEST_ENABLED=false
# Platform allowlist (leave empty for all platforms)
# Examples: youtube.com,youtu.be,vimeo.com,dailymotion.com,twitter.com,tiktok.com
MEDIA_URL_ALLOWLIST=
